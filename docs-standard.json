{
  "version": 1,
  "profile": "cli-product",
  "capabilities": ["stateful", "research"],
  "docs_root": "docs",
  "root_index": "docs/INDEX.md",
  "folder_index": "INDEX.md",
  "required_paths": [
    "README.md",
    "AGENTS.md",
    "docs/INDEX.md",
    "docs/documentation-policy.md",
    "docs/documentation-procedure.md",
    "docs/architecture/maintainer-map.md",
    "docs/planning/roadmap.md",
    "docs/limits/current-limitations.md",
    "docs/development/documentation-coverage.md",
    "docs/development/behavioral-contract-matrix.md",
    "lexicon/docs/README.md",
    "arcana/docs/README.md"
  ],
  "index_exempt_directories": ["stubs"],
  "section_exemptions": ["docs/INDEX.md", "docs/**/INDEX.md", "docs/development/recent-changes-2026-07.md"],
  "required_sections": ["Purpose", "Overview", "Related docs", "Notes"],
  "baseline": "docs-standard.baseline.json",
  "coverage": [
    {
      "paths": ["cmd/**", "internal/**", "evaluation/**", "lexicon/**", "arcana/**"],
      "docs": ["docs/development/documentation-coverage.md"]
    }
  ],
  "change_rules": [
    {
      "paths": ["cmd/**", "internal/**"],
      "docs": ["docs/architecture/**", "docs/reference/**", "docs/development/documentation-coverage.md"]
    },
    {
      "paths": ["lexicon/**"],
      "docs": ["lexicon/docs/**", "docs/reference/lexicon.md", "docs/development/behavioral-contract-matrix.md"]
    },
    {
      "paths": ["arcana/**"],
      "docs": ["arcana/docs/**", "docs/reference/arcana.md", "docs/development/behavioral-contract-matrix.md"]
    }
  ]
}
